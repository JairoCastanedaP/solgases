# Copy to .env (git-ignored) and set real values. Never commit .env.
# Used by the application (local profile) and by docker-compose.yml.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=solgases
DB_USERNAME=solgases
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Base64-encoded HS256 signing key of at least 256 bits, e.g. generated with: openssl rand -base64 32
JWT_SECRET=
