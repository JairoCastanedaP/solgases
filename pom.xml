<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.solgases</groupId>
    <artifactId>solgases</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>solgases</name>
    <description>SOLGASES backend - Clean Architecture multi-module application</description>

    <modules>
        <module>domain</module>
        <module>application</module>
        <module>infrastructure</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <springdoc-openapi.version>2.9.1</springdoc-openapi.version>
        <!-- Managed in dependencyManagement below; springdoc 2.9.1 defaults to 5.32.14 -->
        <swagger-ui.version>5.33.2</swagger-ui.version>
        <!-- JaCoCo version compatible with Java 21 class files -->
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <!-- SonarScanner for Maven 5.x requires a Java 21+ runtime -->
        <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>
        <!-- Overrides the Tomcat version managed by Spring Boot 3.5.16 (10.1.55), affected by CVEs fixed in 10.1.56 to
             10.1.60 (Dependency-Check and Apache Tomcat security advisories, 2026-10-17). Embedded Tomcat is only used
             by java -jar; WebLogic provides its own container. Remove when Spring Boot manages 10.1.61 or later. -->
        <tomcat.version>10.1.61</tomcat.version>
        <!-- Overrides the Jackson BOM managed by Spring Boot 3.5.16 (2.21.4), affected by jackson-core and
             jackson-databind advisories fixed in 2.21.5 to 2.21.8 (GitHub Security Advisories, 2026-10-17).
             Remove when Spring Boot manages 2.21.8 or later. -->
        <jackson-bom.version>2.21.8</jackson-bom.version>
        <!-- Overrides the commons-lang3 version managed by Spring Boot 3.5.16 (3.17.0, CVE-2025-48924 fixed in 3.18.0).
             3.20.0 is the version declared by swagger-core 2.2.55, its only consumer in the WAR (via springdoc). -->
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <!-- Overrides the Log4j BOM managed by Spring Boot 3.5.16 (2.24.3); log4j-api is affected by CVE-2026-49844,
             fixed in 2.25.5 (Apache Logging security page). Only log4j-api and the log4j-to-slf4j bridge are used. -->
        <log4j2.version>2.25.5</log4j2.version>
        <!-- Overrides the Connector/J version managed by Spring Boot (9.7.0, affected by high CVEs). 26.7.0 supports
             MySQL Server 8.4 and later; the local MySQL instance runs 8.4.12 (Increment 7). -->
        <mysql.version>26.7.0</mysql.version>
        <!-- Required by Spring Security's Argon2PasswordEncoder; not managed by Spring Boot -->
        <bouncycastle.version>1.86</bouncycastle.version>
        <!-- Architecture rules (ADR-0006); not managed by Spring Boot -->
        <archunit.version>1.5.1</archunit.version>
        <!-- OWASP Dependency-Check (NVD). The NVD API key is read from the NVD_API_KEY environment variable -->
        <dependency-check-maven.version>12.2.2</dependency-check-maven.version>
        <!-- The aggregate report of the infrastructure module covers the three modules. The SonarQube
             host URL and token are not configured here: pass them at analysis time (SONAR_HOST_URL, SONAR_TOKEN). -->
        <sonar.projectKey>solgases</sonar.projectKey>
        <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/infrastructure/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.solgases</groupId>
                <artifactId>domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.solgases</groupId>
                <artifactId>application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>
            <!-- springdoc 2.9.1 ships swagger-ui 5.32.14, which bundles DOMPurify 3.4.13 (GHSA-6688-9rhm-gjv2,
                 GHSA-p98j-92pf-mc4p). swagger-ui 5.33.2 bundles DOMPurify 3.4.16, which fixes both. -->
            <dependency>
                <groupId>org.webjars</groupId>
                <artifactId>swagger-ui</artifactId>
                <version>${swagger-ui.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
                <!-- Run explicitly: mvn -B org.owasp:dependency-check-maven:aggregate (see docs/mvp1.md, Increment 7) -->
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${dependency-check-maven.version}</version>
                    <configuration>
                        <!-- Critical findings (CVSS 9.0-10.0) fail the build; high ones are triaged manually -->
                        <failBuildOnCVSS>9</failBuildOnCVSS>
                        <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                        <suppressionFiles>
                            <suppressionFile>${maven.multiModuleProjectDirectory}/dependency-check-suppressions.xml</suppressionFile>
                        </suppressionFiles>
                        <formats>
                            <format>HTML</format>
                            <format>JSON</format>
                        </formats>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Per-module coverage report: <module>/target/site/jacoco -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
